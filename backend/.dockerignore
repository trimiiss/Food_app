# Keep the build context small and the image free of local state.
# Note: only files are excluded, never the directories themselves — Laravel
# needs storage/ and bootstrap/cache/ to exist and be writable.
.env
.env.*
.git
.phpunit.result.cache
/.phpunit.cache
vendor
node_modules
tests
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
# Local development database — Render runs on PostgreSQL.
database/database.sqlite
